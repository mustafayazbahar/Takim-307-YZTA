# Google AI Studio'dan ücretsiz alınır: https://aistudio.google.com → "Get API key"
GEMINI_API_KEY=buraya_kendi_anahtarinizi_yapistirin

# İsteğe bağlı yedek anahtarlar: ilk anahtarın günlük kotası dolduğunda
# sistem otomatik olarak sıradakine geçer. Canlı demolarda kesinti yaşamamak
# için takım üyelerinin anahtarlarını buraya eklemek önerilir.
# GEMINI_API_KEY_2=ikinci_anahtar
# GEMINI_API_KEY_3=ucuncu_anahtar

# İsteğe bağlı: modeli elle sabitlemek isterseniz. Boş bırakılırsa uygulama
# API'nin sunduğu en yeni Flash sürümünü otomatik seçer.
# GEMINI_MODEL=gemini-3.7-flash

# Yalnızca bulut/konteyner ortamlarında: hazır Chromium ikilisinin yolu.
# CHROMIUM_PATH=/usr/bin/chromium
